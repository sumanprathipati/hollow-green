# Hollow Green local config. Never commit real secrets.
# Backend-only. The frontend must never read these values.
# The frontend needs only NEXT_PUBLIC_API_BASE_URL (build-time, never a secret).
GITHUB_TOKEN=
PUBLIC_REPOS=octocat/Hello-World
# Optional evidence-review provider (backend-only; never use NEXT_PUBLIC_ here).
# AI_REVIEW_PROVIDER=openai_compatible
# AI_REVIEW_BASE_URL=
# AI_REVIEW_MODEL=
# AI_REVIEW_API_KEY=
# Deployment (backend-only; safe defaults apply when unset):
# ENVIRONMENT=development
# ALLOWED_ORIGINS=https://<your-vercel-domain>
# TRUST_PROXY_HEADERS=0
# Test-only (never set in production):
# E2E_TEST_MODE=
# PUBLIC_DATA_FIXTURE_ONLY=
